{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "baseBranchPatterns": [
    "develop"
  ],
  "ignorePaths": [
    "/build/**"
  ],
  "configMigration": true,
  "minimumReleaseAge": "7 days",
  "semanticCommits": "enabled",
  "packageRules": [
    {
      "description": "No delay for self-made deps",
      "matchDatasources": [
        "github-tags"
      ],
      "matchDepNames": [
        "cloudogu/**"
      ],
      "minimumReleaseAge": "0 days"
    }
  ]
}
